<?xml version="1.0" encoding="utf-8"?>
<!--
  Android bloquea el trafico HTTP en claro desde API 28. El backend de
  desarrollo corre en http://10.0.2.2:8000 sin TLS, asi que hay que permitirlo.

  Esta excepcion vive en src/debug/, por lo que NO forma parte de la build de
  release: en produccion el trafico en claro sigue bloqueado. Y se limita a los
  hosts de desarrollo en vez de abrir el trafico entero con
  usesCleartextTraffic="true".

  10.0.2.2 es como el emulador de Android ve el localhost de la maquina.
  Para probar en un telefono fisico hay que agregar aca la IP de la maquina
  en la red local, ademas de pasarla por dart-define (ver core/config.dart).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
