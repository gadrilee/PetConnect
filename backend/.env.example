# Copiar a .env y ajustar. El .env NO se versiona.

SECRET_KEY=cambiar-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# --- Base de datos ---
# Opcion A: PostgreSQL en Docker (recomendada)
#   docker run --name alquilamatch-db -e POSTGRES_PASSWORD=devpass \
#     -e POSTGRES_DB=alquilamatch -p 5432:5432 -d postgres:17
DB_NAME=alquilamatch
DB_USER=postgres
DB_PASSWORD=devpass
DB_HOST=localhost
DB_PORT=5432

# Opcion B: SQLite, para levantar sin Docker
USE_SQLITE=False

# --- Flutter ---
# 10.0.2.2 es como el emulador de Android ve el localhost de la maquina
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000

# --- Punto de referencia para "minutos caminando" ---
# Verificar en el mapa antes de confiar en el calculo
UAGRM_LAT=-17.7757
UAGRM_LNG=-63.1980
